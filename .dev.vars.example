# Copy to .dev.vars for Wrangler/OpenNext preview (never commit real secrets).
# Copy .env.example to .env for Next dev and Prisma CLI; these are separate loaders.
APP_ENV="local"
APP_URL="http://localhost:8787"
AUTH_URL="http://localhost:8787"
AUTH_TRUST_HOST="true"
AUTH_SECRET="generate-a-new-test-secret"
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/cheetahinvite_test"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
CRON_SECRET="generate-a-different-test-secret"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_OXXO_ENABLED="false"
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
MERCADOPAGO_ENVIRONMENT="sandbox"
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Cheetah Invite <acceso@your-test-domain.example>"
