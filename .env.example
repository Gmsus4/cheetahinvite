AUTH_SECRET="generate-a-long-random-secret"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cheetahinvite_test?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/cheetahinvite_test?schema=public"
# Use only a separate test database in this worktree.
# R2, IMAGES and BROWSER use Wrangler bindings, not API keys.
APP_ENV="local"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# CHROMIUM_EXECUTABLE_PATH is only used by standalone browser test scripts.
# Runtime captures use the BROWSER binding. See docs/cloudflare-migration.md.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Activa OXXO también en Stripe Dashboard antes de habilitar esta opción.
STRIPE_OXXO_ENABLED="false"
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
MERCADOPAGO_ENVIRONMENT="sandbox"
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Soccasion <acceso@your-verified-domain.com>"
CRON_SECRET=""
