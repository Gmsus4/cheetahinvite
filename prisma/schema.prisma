generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  sessionVersion  Int       @default(0)
  passwordResetHash String? @unique
  passwordResetExpiresAt DateTime?
  invitationCount Int       @default(0)
  accounts        Account[]
  sessions        Session[]
  events          Event[]
}

enum EventStatus {
  DRAFT
  PENDING_PAYMENT
  PUBLISHED
  EXPIRED
  ARCHIVED
  SUSPENDED
  REFUNDED
}

model Event {
  id           String      @id @default(cuid())
  ownerId      String
  name         String
  eventType    String
  hostNames    String?
  venue        String?
  address      String?
  message      String?     @db.Text
  imageUrl     String?     @db.Text
  backgroundImageUrl String? @db.Text
  imageUploads Int         @default(0)
  contentVersion Int       @default(0)
  accent       String      @default("#E9560A")
  buttonShape String @default("square")
  buttonFilled Boolean @default(true)
  buttonIcons Boolean @default(true)
  buttonBold Boolean @default(true)
  buttonBorder Boolean @default(false)
  heroHorizontal String @default("left")
  heroVertical String @default("center")
  typography   String      @default("default")
  bodyTypography String    @default("inter")
  panelStyle   String      @default("auto")
  blurIntensity Int        @default(50)
  sections     Json        @default("[]")
  slug         String?     @unique
  customSlug   String?     @db.VarChar(80)
  templateId   String      @default("none")
  texture      String      @default("none")
  status       EventStatus @default(DRAFT)
  eventDate    DateTime?
  eventTime    String?     @db.VarChar(5)
  expiresAt    DateTime?
  paidAt       DateTime?
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId String? @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  owner        User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rsvpResponses RsvpResponse[]
  rsvpBudgets RsvpSubmissionBudget[]
  invitationLinks InvitationLink[]

  @@index([ownerId, status])
  @@unique([ownerId, customSlug])
}

// Keeps previous URLs reserved for the same invitation after a rename.
model InvitationLink {
  path String @id
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordRecoveryLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

enum CloudinaryAssetState {
  UPLOADING
  READY
  DELETE_PENDING
}

// No cascading foreign keys: cleanup records must survive event/account deletion.
model CloudinaryAsset {
  publicId      String @id
  ownerId       String
  eventId       String
  url           String? @db.Text
  bytes         Int
  state         CloudinaryAssetState @default(UPLOADING)
  expiresAt     DateTime?
  nextAttemptAt DateTime?
  attempts      Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventId, state])
  @@index([ownerId])
  @@index([state, expiresAt])
  @@index([state, nextAttemptAt])
}

model ImageUploadBudget {
  key       String @id
  ownerId   String
  count     Int @default(1)
  expiresAt DateTime

  @@index([ownerId, expiresAt])
}

enum InvitationPaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

// Purchase records survive invitation/account deletion. Store no card data.
model InvitationPayment {
  id                      String @id @default(uuid())
  ownerId                 String
  eventId                 String
  eventName               String
  amount                  Int
  currency                String
  status                  InvitationPaymentStatus @default(PENDING)
  livemode                Boolean
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeChargeId          String? @unique
  checkoutExpiresAt       DateTime
  paidAt                  DateTime?
  expiresAt               DateTime?
  refundedAmount          Int @default(0)
  refundPendingAmount     Int @default(0)
  refunds                 Json @default("[]")
  disputes                Json @default("[]")
  disputeStatus           String?
  lastSyncedAt            DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([ownerId, createdAt])
  @@index([eventId])
}

model RsvpResponse {
  id         String @id @default(uuid())
  eventId    String
  tokenHash  String
  name       String @db.VarChar(120)
  attending  Boolean
  companions Int @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, tokenHash])
  @@index([eventId, createdAt])
}

model RsvpSubmissionBudget {
  key       String @id
  eventId   String
  count     Int @default(1)
  expiresAt DateTime
  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, expiresAt])
}
